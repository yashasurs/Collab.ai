# Server
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database — PostgreSQL (production) or SQLite (local dev fallback)
# PostgreSQL (recommended):
DATABASE_URL=postgresql://colab:colab_secret@localhost:5432/colabdb
# SQLite fallback (local dev without Docker):
# DATABASE_URL=sqlite:///./colab.db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Agent
GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256

# Cloudflare Tunnel (optional)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Container Orchestration
ORCHESTRATOR_TYPE=docker
# ORCHESTRATOR_TYPE=kubernetes
