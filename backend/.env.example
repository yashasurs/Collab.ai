# Server
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database — PostgreSQL (production) or SQLite (local dev fallback)
# PostgreSQL (recommended — matches docker-compose.yml):
DATABASE_URL=postgresql://colab:colab_secret@localhost:5432/colabdb
# SQLite fallback (local dev without Docker):
# DATABASE_URL=sqlite:///./colab.db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Agent
GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256

# Container Orchestration
ORCHESTRATOR_TYPE=docker
# ORCHESTRATOR_TYPE=kubernetes

# Logging
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Tunnel Broker (optional tuning)
# MAX_TUNNELS_PER_USER=3
# TUNNEL_IDLE_TIMEOUT=1800
